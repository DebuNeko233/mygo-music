{
  "name": "Nyago Music",
  "identifier": "io.github.debuneko233.nyagomusic",
  "slug": "nyago-music",
  "version": "0.3.2",
  "out": "build",
  "urlSchemes": ["orpheus"],
  "fileAssociations": [
    {"ext": ["mp3"], "name": "MP3 音频", "mimeType": "audio/mpeg", "role": "Viewer"},
    {"ext": ["flac"], "name": "FLAC 音频", "mimeType": "audio/flac", "role": "Viewer"},
    {"ext": ["wav"], "name": "WAV 音频", "mimeType": "audio/wav", "role": "Viewer"},
    {"ext": ["ogg"], "name": "Ogg Vorbis 音频", "mimeType": "audio/ogg", "role": "Viewer"},
    {"ext": ["m4a"], "name": "M4A 音频", "mimeType": "audio/mp4", "role": "Viewer"},
    {"ext": ["aac"], "name": "AAC 音频", "mimeType": "audio/aac", "role": "Viewer"},
    {"ext": ["3gp"], "name": "3GPP 音频", "mimeType": "audio/3gpp", "role": "Viewer"},
    {"ext": ["3g2"], "name": "3GPP2 音频", "mimeType": "audio/3gpp2", "role": "Viewer"}
  ],
  "updates": {
    "publicKey": "vQcwBoFXWKyjsHC1GmgrtfGsVfks/+hUyeA4zauEIJ8=",
    "github": "DebuNeko233/nyago-music"
  },
  "macos": {
    "entitlements": "macos.entitlements.plist",
    "icon": "icon/AppIcon.icon",
    "minimumSystemVersion": "13.0",
    "infoPlist": {
      "CFBundleDocumentTypes": [
        {"CFBundleTypeName": "MP3 音频", "CFBundleTypeRole": "Viewer", "LSHandlerRank": "Alternate", "LSItemContentTypes": ["public.mp3"]},
        {"CFBundleTypeName": "FLAC 音频", "CFBundleTypeRole": "Viewer", "LSHandlerRank": "Alternate", "LSItemContentTypes": ["org.xiph.flac"]},
        {"CFBundleTypeName": "WAV 音频", "CFBundleTypeRole": "Viewer", "LSHandlerRank": "Alternate", "LSItemContentTypes": ["com.microsoft.waveform-audio"]},
        {"CFBundleTypeName": "Ogg Vorbis 音频", "CFBundleTypeRole": "Viewer", "LSHandlerRank": "Alternate", "LSItemContentTypes": ["org.xiph.ogg-audio"]},
        {"CFBundleTypeName": "M4A 音频", "CFBundleTypeRole": "Viewer", "LSHandlerRank": "Alternate", "LSItemContentTypes": ["public.mpeg-4-audio"], "CFBundleTypeMIMETypes": ["audio/mp4"]},
        {"CFBundleTypeName": "AAC 音频", "CFBundleTypeRole": "Viewer", "LSHandlerRank": "Alternate", "LSItemContentTypes": ["public.aac-audio"], "CFBundleTypeMIMETypes": ["audio/aac", "audio/aacp", "audio/mp4a-latm", "audio/mpeg4-generic"]},
        {"CFBundleTypeName": "3GPP 音频", "CFBundleTypeRole": "Viewer", "LSHandlerRank": "Alternate", "LSItemContentTypes": ["public.3gpp"], "CFBundleTypeExtensions": ["3gp"], "CFBundleTypeMIMETypes": ["audio/3gpp"]},
        {"CFBundleTypeName": "3GPP2 音频", "CFBundleTypeRole": "Viewer", "LSHandlerRank": "Alternate", "LSItemContentTypes": ["public.3gpp2"], "CFBundleTypeExtensions": ["3g2"], "CFBundleTypeMIMETypes": ["audio/3gpp2"]}
      ]
    }
  },
  "linux": {
    "installDirName": "Nyago Music",
    "comment": "第三方某音乐桌面客户端",
    "categories": ["AudioVideo", "Audio", "Player"],
    "actions": [
      {"id": "NyagoRepeat", "name": "切换循环模式", "args": ["--playback-action=repeat"], "icon": "media-playlist-repeat"},
      {"id": "NyagoShuffle", "name": "切换随机播放", "args": ["--playback-action=shuffle"], "icon": "media-playlist-shuffle"},
      {"id": "NyagoPlayPause", "name": "播放/暂停", "args": ["--playback-action=play-pause"], "icon": "media-playback-start"},
      {"id": "NyagoNext", "name": "下一首", "args": ["--playback-action=next"], "icon": "media-skip-forward"},
      {"id": "NyagoPrevious", "name": "上一首", "args": ["--playback-action=previous"], "icon": "media-skip-backward"}
    ],
    "webview": false
  }
}
