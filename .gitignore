# Go / MyGo 桌面项目
# 保留 go.mod、go.sum、源码、资源、测试样本和项目协作配置。

# ------------------------------------------------------------
# 构建、打包与发布产物
# ------------------------------------------------------------
/build/
/dist/
/out/
/bin/
/release/
/releases/
/artifacts/
/.mygo/

# 在仓库根目录直接执行 go build 生成的程序
/netease-music-mygo
/netease-music-mygo.exe
/mygo-cloudmusic
/mygo-cloudmusic.exe

# MyGo 自动生成的 Windows 资源对象
mygo_windows_*.syso

# ------------------------------------------------------------
# Go 本地缓存、工作区与调试文件
# ------------------------------------------------------------
/.gocache/
/.gomodcache/
/.gopath/
/.gobin/

# 当前项目为单模块；本地多仓库联调文件不提交
/go.work
/go.work.sum

# Go 测试程序与 Delve 调试程序
*.test
*.test.exe
__debug_bin
__debug_bin.*
debug.test

# ------------------------------------------------------------
# 测试报告、覆盖率与性能分析
# ------------------------------------------------------------
/coverage/
/test-results/
/test-reports/
/debug-frames/
/debug-shots/
/profiles/
coverage.out
coverage-*.out
coverage.html
coverage-*.html
junit.xml
*.pprof
*.prof
*.trace

# ------------------------------------------------------------
# 日志、临时文件与本地工作目录
# ------------------------------------------------------------
/logs/
/tmp/
/temp/
/work/
/scratch/
/.cache/
*.log
*.log.*
*.tmp
*.temp
*.bak
*.orig
*.rej
*~

# ------------------------------------------------------------
# 本地环境变量和签名凭据
