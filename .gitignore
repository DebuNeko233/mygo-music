.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template

/.secrets/
/signing-local/
*.private.key
*.private.pem
*.p8
*.p12
*.pfx
*.mobileprovision
*.provisionprofile

